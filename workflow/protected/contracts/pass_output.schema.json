{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pass Output",
  "description": "Running or finalized result. Evidence references and input/output coverage require cross-record verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "pass_id",
    "action_id",
    "action_revision",
    "status",
    "started_at",
    "finished_at",
    "summary",
    "actual_actions",
    "deliverables",
    "verification",
    "party_outcomes",
    "evidence",
    "state_changes",
    "unresolved_items",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_kind": {
      "enum": [
        "execution",
        "example"
      ]
    },
    "pass_id": {
      "type": "string",
      "pattern": "^pass_[0-9]{3,}$"
    },
    "action_id": {
      "type": "string",
      "pattern": "^step_[0-9]{2,}$"
    },
    "action_revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "running",
        "passed",
        "failed",
        "blocked",
        "interrupted"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "actual_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "location",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 0
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "result",
          "actual",
          "evidence_refs"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not_checked"
            ]
          },
          "actual": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "minItems": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "enum": [
                    "passed",
                    "failed"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence_refs": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    },
    "party_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "party_id",
          "outcome_id",
          "result",
          "actual",
          "evidence_refs"
        ],
        "properties": {
          "party_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "outcome_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not_checked"
            ]
          },
          "actual": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "minItems": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "enum": [
                    "passed",
                    "failed"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence_refs": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "location",
          "description",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "enum": [
              "direct_execution",
              "human_supplied",
              "document_review",
              "synthetic"
            ]
          }
        }
      },
      "minItems": 0
    },
    "state_changes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    },
    "next_action": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "running"
          }
        }
      },
      "then": {
        "properties": {
          "finished_at": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "finished_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "minItems": 1,
            "items": {
              "properties": {
                "result": {
                  "const": "passed"
                }
              }
            }
          },
          "party_outcomes": {
            "minItems": 1,
            "items": {
              "properties": {
                "result": {
                  "const": "passed"
                }
              }
            }
          },
          "deliverables": {
            "minItems": 1
          },
          "evidence": {
            "minItems": 1
          },
          "unresolved_items": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "verification": {
                "contains": {
                  "properties": {
                    "result": {
                      "const": "failed"
                    }
                  },
                  "required": [
                    "result"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "party_outcomes": {
                "contains": {
                  "properties": {
                    "result": {
                      "const": "failed"
                    }
                  },
                  "required": [
                    "result"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "execution"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "items": {
              "properties": {
                "source": {
                  "not": {
                    "const": "synthetic"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
