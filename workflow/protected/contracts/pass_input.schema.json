{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pass Input",
  "description": "Frozen execution contract. Structural validation must be followed by the semantic checks in workflow.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "pass_id",
    "action_id",
    "action_revision",
    "created_at",
    "goal_ref",
    "previous_pass_id",
    "objective",
    "starting_state",
    "sources",
    "parties",
    "resources",
    "scope",
    "constraints",
    "authorization",
    "deliverables",
    "acceptance_criteria",
    "execution_plan",
    "recovery"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_kind": {
      "enum": [
        "execution",
        "example"
      ]
    },
    "pass_id": {
      "type": "string",
      "pattern": "^pass_[0-9]{3,}$"
    },
    "action_id": {
      "type": "string",
      "pattern": "^step_[0-9]{2,}$"
    },
    "action_revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "goal_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "previous_pass_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^pass_[0-9]{3,}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "starting_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed_facts",
        "assumptions",
        "unknowns"
      ],
      "properties": {
        "confirmed_facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "location",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 1
    },
    "parties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "role",
          "authority",
          "expected_outcomes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "authority": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "expected_outcomes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "condition",
                "verification"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "condition": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "verification": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "location"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 0
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded"
      ],
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reference",
        "basis",
        "scope"
      ],
      "properties": {
        "status": {
          "const": "granted"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        }
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "location",
          "format"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "format": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "condition",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "condition": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "verification": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 1
    },
    "execution_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "party_id",
          "operation",
          "expected_result"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "party_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "operation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "expected_result": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 1
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_passes_per_revision",
        "stop_condition",
        "missing_information",
        "failure_handling"
      ],
      "properties": {
        "max_passes_per_revision": {
          "type": "integer",
          "minimum": 1
        },
        "stop_condition": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "missing_information": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "failure_handling": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
