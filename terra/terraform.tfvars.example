  gpu_test_003 = {
    is_true = true
    is_spot = true
  }
  test_002 = {
    is_true = true
    is_spot = true
  }
  test_003 = {
    is_true = true
    is_spot = true
  }
  test_004 = {
    is_true = true
    is_spot = true
  }
}
